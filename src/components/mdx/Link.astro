---
const { href, ...rest } = Astro.props;
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class="blog-link"
  {...rest}
>
  <slot />
</a>

<style>
  .blog-link,
  .blog-link:visited {
    color: var(--link);
    text-decoration: none;
  }

  .blog-link:hover {
    text-decoration: underline;
  }
  .blog-link:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }
</style>
