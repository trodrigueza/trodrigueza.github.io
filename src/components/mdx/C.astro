---
// src/components/mdx/C.astro
const { variant, red, green, gray, blue, class: cls = "" } = Astro.props;

let color = variant || "blue";
if (red) color = "red";
if (green) color = "green";
if (gray) color = "gray";
if (blue) color = "blue";

const map = { blue: "c-blue", red: "c-red", green: "c-green", gray: "c-gray" };
const colorClass = map[color as keyof typeof map] ?? color;
---

<span class={`${colorClass} ${cls}`.trim()}><slot /></span>

<style>
  .c-blue {
    color: var(--link);
  }
  .c-red {
    color: var(--resalt2);
  }
  .c-green {
    color: var(--resalt);
  }
  .c-gray {
    color: #6b7280;
  }
</style>
