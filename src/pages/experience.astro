---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import Exp from "../components/Exp.astro";
import SectionContainer from "../components/SectionContainer.astro";
import CalendarIcon from "../components/icons/Calendar.astro";
import { execSync } from "child_process";

let formattedDate: string;
try {
    const lastCommitDate = execSync("git log -1 --format=%cI")
        .toString()
        .trim();
    formattedDate = new Date(lastCommitDate).toLocaleString("en-US", {
        weekday: "short",
        day: "numeric",
        month: "short",
        year: "numeric",
        hour: "2-digit",
        minute: "2-digit",
        timeZone: "America/Bogota",
        timeZoneName: "shortOffset",
    });
} catch (e) {
    console.warn("Could not get git commit date, falling back to static label");
    formattedDate = "Recently updated";
}
---

<Layout title="trodrigueza">
    <main class="px-6">
        <SectionContainer
            class="flex flex-col items-center justify-center gap-y-12"
        >
            <SectionContainer>
                <h2
                    class="text-2xl font-semibold mb-6 flex gap-x-2 items-center"
                >
                    <CalendarIcon class="w-7 h-7 mr-2" />
                    Some things I've worked on
                </h2>
                <p>(I intend to write posts for some of these...)</p>
                <Exp />
            </SectionContainer>
        </SectionContainer>

        <SectionContainer>
            <p
                class="text-cyan flex text-center text-xs md:text-2xs dark:text-cyan-1000"
            >
                Last update: {formattedDate}
            </p>
        </SectionContainer>
    </main></Layout
>
